; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Voxel Support"
config/tags=PackedStringArray("tool")
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dryeet8uchrw"

[autoload]

DevMCP="*res://addons/DEVFramework/MCP/MCPDevServer.gd"

[debug]

settings/stdout/print_fps=true

[dev_framework]

gdextension_build/build_types=PackedStringArray("release")

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/DEVFramework/plugin.cfg", "res://addons/VoxelSupport/plugin.cfg")

[threading]

worker_pool/max_threads=16.0
