# Normalize line endings for all files that Git considers text files.
* text=auto eol=lf

# Only include the addons folder when downloading from the Asset Library.
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore

# DEVFramework 是作者本地开发期的编辑器工具，不属于体素插件的发布内容，打包时排除。
/addons/DEVFramework     export-ignore
/addons/DEVFramework/**  export-ignore

# 体素二进制资产统一走 Git LFS（.qvx 与 .vox 同级，均为模型源文件）。
*.vox  filter=lfs diff=lfs merge=lfs -text
*.qvx filter=lfs diff=lfs merge=lfs -text

# 原生扩展产物同样走 LFS：它们必须被版本跟踪（插件开箱即用，不能要求用户自己装编译器），
# 但每份都有 0.8~1.8 MB 且每次重链都会变 —— 直接进主仓会让历史迅速膨胀。
*.dll   filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text