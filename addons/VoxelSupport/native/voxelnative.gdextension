[configuration]

entry_symbol = "voxelnative_library_init"
compatibility_minimum = "4.3"

[libraries]

macos.debug.arm64 = "res://addons/VoxelSupport/native/libvoxelnative.macos.debug.arm64.dylib"
macos.release.arm64 = "res://addons/VoxelSupport/native/libvoxelnative.macos.release.arm64.dylib"
macos.debug.x86_64 = "res://addons/VoxelSupport/native/libvoxelnative.macos.debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/VoxelSupport/native/libvoxelnative.macos.release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/VoxelSupport/native/voxelnative.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/VoxelSupport/native/voxelnative.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://addons/VoxelSupport/native/libvoxelnative.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/VoxelSupport/native/libvoxelnative.linux.release.x86_64.so"
