[configuration]

entry_symbol = "voxelnative_library_init"
compatibility_minimum = "4.3"

[libraries]

macos.debug = "res://addons/VoxelSupport/Native/libvoxelnative.macos.release.universal.dylib"
macos.release = "res://addons/VoxelSupport/Native/libvoxelnative.macos.release.universal.dylib"
windows.debug.x86_64 = "res://addons/VoxelSupport/Native/voxelnative.windows.release.x86_64.dll"
windows.release.x86_64 = "res://addons/VoxelSupport/Native/voxelnative.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://addons/VoxelSupport/Native/libvoxelnative.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/VoxelSupport/Native/libvoxelnative.linux.release.x86_64.so"
