macos.release.x86_64 = "res://addons/DEVFramework/Entity/ECS/Native/libdevecs.macos.release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/DEVFramework/Entity/ECS/Native/devecs.windows.debug.x86_64.dll"
